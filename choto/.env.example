# Copy to .env for local development (never commit .env)
DATABASE_URL=postgres://localhost:5432/choto
PORT=3000
# Public base URL used to build short links (set to your domain in production)
BASE_URL=http://localhost:3000
# Number of reverse proxies in front of the app (PaaS = 1). Needed for correct client IPs.
TRUST_PROXY=1
CACHE_MAX=50000
CACHE_TTL_MS=300000
